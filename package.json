{
  "name": "open-deutsch",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first German-learning companion for Codex.",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": "11.0.9"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "pnpm --recursive --if-present run build",
    "dev": "node scripts/lifecycle.mjs start dev",
    "prd": "pnpm run build && node scripts/lifecycle.mjs start prd",
    "start": "pnpm run prd",
    "status": "node scripts/lifecycle.mjs status",
    "kill": "node scripts/lifecycle.mjs kill",
    "logs": "node scripts/lifecycle.mjs logs --follow",
    "logs:errors": "node scripts/lifecycle.mjs logs --follow --errors",
    "logs:clear": "node scripts/lifecycle.mjs logs-clear",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "toolchain:check:integration": "node scripts/check-toolchain.mjs --require-codex",
    "test:toolchain": "node --test tests/toolchain-diagnostics.test.mjs",
    "test:workspace": "node --test tests/workspace-layout.test.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:fast",
    "test:fast": "node --test tests/*.test.mjs",
    "test": "pnpm run test:fast",
    "test:e2e": "node scripts/run-required-workspace-script.mjs test:e2e",
    "test:plugin": "node scripts/run-required-workspace-script.mjs test:plugin",
    "test:all": "pnpm run test:fast && pnpm run test:e2e && pnpm run test:plugin",
    "doctor": "node scripts/doctor.mjs",
    "package": "node scripts/run-required-workspace-script.mjs package",
    "verify:live": "node scripts/confirm-and-run.mjs live verify:live:run",
    "verify:plugin": "node scripts/confirm-and-run.mjs plugin verify:plugin:run",
    "plugin:install": "node scripts/run-required-workspace-script.mjs plugin:install --require-codex",
    "plugin:refresh": "node scripts/run-required-workspace-script.mjs plugin:refresh --require-codex",
    "plugin:status": "node scripts/run-required-workspace-script.mjs plugin:status",
    "plugin:uninstall": "node scripts/run-required-workspace-script.mjs plugin:uninstall --require-codex",
    "service:dev": "node scripts/run-required-workspace-script.mjs service:dev",
    "service:prd": "node scripts/run-required-workspace-script.mjs service:prd"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
