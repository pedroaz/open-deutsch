{
  "name": "@open-deutsch/codex-client",
  "version": "0.1.0",
  "private": true,
  "description": "Narrow Codex App Server process and workload-policy adapter.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b --force",
    "test": "pnpm --workspace-root exec vitest run --config vitest.config.mjs --project codex-client",
    "probe:app-server:authenticated:run": "node ../../scripts/probe-app-server-authenticated.mjs",
    "probe:app-server:capabilities:authenticated:run": "node ../../scripts/probe-app-server-capabilities-authenticated.mjs"
  },
  "dependencies": {
    "@open-deutsch/contracts": "workspace:*",
    "zod": "4.4.3"
  }
}
